
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["customer", "merchant", "rider"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog item stored in Supabase",
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image_url": { "type": "string" },
        "is_in_stock": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Supabase-side table to manage write permissions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "format": "uuid" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and roles"
    }
  }
}
